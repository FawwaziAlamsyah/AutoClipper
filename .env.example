APP_NAME=Daboji Auto Clipper
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_auto_clipper

LOG_LEVEL=INFO

# Upload
MAX_UPLOAD_SIZE_MB=2048

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# YouTube download (opsional — hindari 403 anti-bot)
# Path ke cookies.txt hasil export "Get cookies.txt LOCALLY" extension.
# Kosong = pakai cookiesfrombrowser (Chrome/Firefox/Edge) secara berurutan.
COOKIES_FILE=data/cookies.txt
