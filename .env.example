APP_NAME=Daboji Auto Clipper
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_auto_clipper

LOG_LEVEL=INFO

# Upload
MAX_UPLOAD_SIZE_MB=2048

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda  # eksplisit, jangan "auto" — biar keliatan kalau CUDA gagal terdeteksi

# LLM (OpenAI-compatible)
# Opsi A — 9Router proxy lokal: npm install -g 9router && 9router
#   LLM_MODEL=DABOJI
#   LLM_API_KEY=sk-<key dari 9router dashboard>
#   LLM_BASE_URL=http://localhost:20128/v1
# Opsi B — provider langsung: LLM_MODEL=gpt-4o-mini, LLM_BASE_URL=https://api.openai.com/v1
# Key kosong = scoring LLM pakai mock + Auto Hook skip.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Auto Hook Engine — teaser cold-open 1-5 detik di depan clip (butuh LLM).
# False = matikan seluruh fitur. Gagal hook tidak menggagalkan generate clip.
USE_AUTO_HOOK=true
AUTO_HOOK_MIN_CONFIDENCE=0.6          # threshold confidence LLM (0.0-1.0)
AUTO_HOOK_MIN_WINDOW_SECONDS=20.0     # min durasi window agar hook dicoba

# Legal pages (Privacy Policy / Terms of Service)
# Email kontak utk halaman legal — kosong = navbar/footer tampil tanpa email.
APP_CONTACT_EMAIL=
# Base URL publik halaman legal, kalau suatu saat punya domain.
# Kosong = otomatis pakai URL request.
APP_PUBLIC_URL=

# UI Preferences (default — bisa diubah user lewat menu /settings)
# Bahasa default: en | id
APP_DEFAULT_LANGUAGE=en
# Tema default: light | dark
APP_DEFAULT_THEME=light

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/tiktok/oauth/callback
TIKTOK_TOKEN_ENCRYPTION_KEY=
