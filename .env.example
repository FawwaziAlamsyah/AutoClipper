APP_NAME=Daboji Auto Clipper
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_auto_clipper

LOG_LEVEL=INFO

# Upload
MAX_UPLOAD_SIZE_MB=2048

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda  # eksplisit, jangan "auto" — biar keliatan kalau CUDA gagal terdeteksi

# LLM (OpenAI-compatible)
# Opsi A — 9Router proxy lokal: npm install -g 9router && 9router
#   LLM_MODEL=DABOJI
#   LLM_API_KEY=sk-<key dari 9router dashboard>
#   LLM_BASE_URL=http://localhost:20128/v1
# Opsi B — provider langsung: LLM_MODEL=gpt-4o-mini, LLM_BASE_URL=https://api.openai.com/v1
# Key kosong = scoring LLM pakai mock + Auto Hook skip.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Auto Hook Engine — teaser cold-open 1-5 detik di depan clip (butuh LLM).
# False = matikan seluruh fitur. Gagal hook tidak menggagalkan generate clip.
USE_AUTO_HOOK=true
AUTO_HOOK_MIN_CONFIDENCE=0.6          # threshold confidence LLM (0.0-1.0)
AUTO_HOOK_MIN_WINDOW_SECONDS=20.0     # min durasi window agar hook dicoba

# Legal pages (Privacy Policy / Terms of Service)
# Email kontak utk halaman legal — kosong = navbar/footer tampil tanpa email.
APP_CONTACT_EMAIL=
# Base URL publik halaman legal, kalau suatu saat punya domain.
# Kosong = otomatis pakai URL request.
APP_PUBLIC_URL=

# UI Preferences (default — bisa diubah user lewat menu /settings)
# Bahasa default: en | id
APP_DEFAULT_LANGUAGE=en
# Tema default: light | dark
APP_DEFAULT_THEME=light

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/tiktok/oauth/callback
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Token Encryption (Generik — untuk enkripsi OAuth token di DB, mis. Instagram, TikTok)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Instagram API with Instagram Login (Reels Posting)
# Dapatkan User ID dan Long-lived User Access Token dari Meta for Developers Dashboard
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_TOKEN_ISSUED_AT=
IG_GRAPH_BASE_URL=https://graph.instagram.com
IG_GRAPH_VERSION=
IG_TOKEN_REFRESH_BEFORE_DAYS=5
IG_TOKEN_MIN_AGE_HOURS=24
IG_TOKEN_LIFETIME_DAYS=60
IG_MIN_REEL_SECONDS=3.0
IG_MAX_REEL_SECONDS=90.0
IG_MAX_FILE_MB=0
IG_CAPTION_MAX_CHARS=2200
IG_CAPTION_MAX_HASHTAGS=30
IG_PROCESS_POLL_SECONDS=3.0
IG_PROCESS_TIMEOUT_SECONDS=420

# Instagram 9:16 Video Prep (Auto Reframe)
# Mode: pad (bilah hitam) | blur (latar blur) | off (kirim apa adanya)
IG_FIT_MODE=pad
IG_TARGET_WIDTH=1080
IG_TARGET_HEIGHT=1920
IG_FIT_CRF=20
IG_FIT_PRESET=veryfast
IG_FIT_TIMEOUT_SECONDS=900


