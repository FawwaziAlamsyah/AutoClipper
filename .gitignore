# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment files (abaikan seluruh varian .env kecuali .env.example)
.env*
!.env.example

# Database
*.db
*.sqlite
*.sqlite3

# Runtime data (struktur folder dipertahankan lewat .gitkeep)
data/uploads/*
data/outputs/*
data/cache/*
data/history/*
data/temp/*
data/models/*

# Cookies & sessions — rahasia, jangan pernah ke git
*cookies*.txt
*.cookies
*.session
data/cookies.txt
data/llm_config.json

# Runtime artifacts watermark & score blend — jangan commit (generated)
# (watermark.png & sfx adalah asset default, tetap di-track)
data/score_blend.json
data/assets/watermark_visible.png
data/assets/watermark_ids.json
data/assets/watermark_position.json

!data/**/.gitkeep

# Logs & crash dumps
logs/*
!logs/.gitkeep
*.log

# Certificates, keys & secrets
*.pem
*.key
*.pfx
*.p12

# Test & tooling
.pytest_cache/
.coverage
htmlcov/

# IDE & AI tools local files
.vscode/
.idea/
.claude/settings.local.json
.claude/worktrees/
